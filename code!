<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Silver & Stitch Co.</title>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background: #faf8f5;
        color: #333;
    }

    header {
        background: #c0c0c0;
        color: white;
        padding: 20px;
        text-align: center;
    }

    nav {
        background: #444;
        padding: 12px;
        text-align: center;
    }

    nav a {
        color: white;
        text-decoration: none;
        margin: 0 15px;
        font-weight: bold;
    }

    .hero {
        text-align: center;
        padding: 80px 20px;
        background: linear-gradient(rgba(0,0,0,.4), rgba(0,0,0,.4)),
                    url('https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1400&q=80');
        background-size: cover;
        color: white;
    }

    .hero h1 {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .hero p {
        font-size: 1.2rem;
        margin-bottom: 25px;
    }

    .btn {
        background: #d4af37;
        color: white;
        padding: 12px 25px;
        text-decoration: none;
        border-radius: 5px;
    }

    .section {
        padding: 60px 10%;
    }

    .section h2 {
        text-align: center;
        margin-bottom: 30px;
    }

    .products {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
    }

    .card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.1);
        text-align: center;
    }

    .card img {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }

    .card h3 {
        margin: 15px 0;
    }

    .price {
        color: #b8860b;
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .card button {
        background: #444;
        color: white;
        border: none;
        padding: 10px 20px;
        margin-bottom: 20px;
        cursor: pointer;
        border-radius: 5px;
    }

    .about {
        text-align: center;
        max-width: 800px;
        margin: auto;
        line-height: 1.7;
    }

    form {
        max-width: 600px;
        margin: auto;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    input, textarea {
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    footer {
        background: #444;
        color: white;
        text-align: center;
        padding: 20px;
        margin-top: 40px;
    }
</style>
</head>
<body>

<header>
    <h1>Silver & Stitch Co.</h1>
    <p>Custom Silver Jewelry & Handmade Blankets</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#jewelry">Jewelry</a>
    <a href="#blankets">Blankets</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
    <h1>Handcrafted Gifts Made Just For You</h1>
    <p>Personalized silver jewelry and cozy handmade blankets.</p>
    <a href="#jewelry" class="btn">Shop Now</a>
</section>

<section class="section" id="jewelry">
    <h2>Custom Silver Jewelry</h2>

    <div class="products">
        <div class="card">
            <img src="https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=800&q=80">
            <h3>Name Necklace</h3>
            <p class="price">$49.99</p>
            <button>Add to Cart</button>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80">
            <h3>Engraved Bracelet</h3>
            <p class="price">$39.99</p>
            <button>Add to Cart</button>
        </div>
    </div>
</section>

<section class="section" id="blankets">
    <h2>Handmade Blankets</h2>

    <div class="products">
        <div class="card">
            <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80">
            <h3>Chunky Knit Blanket</h3>
            <p class="price">$89.99</p>
            <button>Add to Cart</button>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=800&q=80">
            <h3>Personalized Baby Blanket</h3>
            <p class="price">$69.99</p>
            <button>Add to Cart</button>
        </div>
    </div>
</section>

<section class="section" id="about">
    <h2>About Us</h2>
    <div class="about">
        <p>
            At Silver & Stitch Co., we create meaningful handcrafted gifts.
            Every silver jewelry piece is customized to your specifications,
            and every blanket is lovingly handmade to bring warmth and comfort.
        </p>
    </div>
</section>

<section class="section" id="contact">
    <h2>Request a Custom Order</h2>

    <form>
        <input type="text" placeholder="Your Name" required>
        <input type="email" placeholder="Email Address" required>
        <textarea rows="5" placeholder="Describe your custom jewelry or blanket request"></textarea>
        <button class="btn" type="submit">Submit Request</button>
    </form>
</section>

<footer>
    <p>&copy; 2026 Silver & Stitch Co. All Rights Reserved.</p>
</footer>

</body>
</html>
